# needs: docker
# step: the host, in service by its commission
. boot/deploy host haiccing/base-component-haicc
# expect: "deployed":"host"
# step: its cluster: the script's commands done in turn, at the host (here a line each, as the script has them)
host crud/create swarms/swarm-1 '{"kind":"swarm"}'
# expect: "value":{"kind":"swarm"}
host boot/deploy swarms/swarm-1/node-1 haiccing/base-component-haicc
# expect: "mrepo":"swarm-1/node-1"
host haicc swarms/swarm-1/node-1 container/create
# expect: "created"
host haicc swarms/swarm-1/node-1 container/start
# expect: "running"
host boot/deploy swarms/swarm-1/node-2 haiccing/base-component-haicc
# expect: "mrepo":"swarm-1/node-2"
host haicc swarms/swarm-1/node-2 container/create
# expect: "created"
host haicc swarms/swarm-1/node-2 container/start
# expect: "running"
# step: the swarm's nodes, and one node's container
host crud/read "swarms/swarm-1/*"
# expect: "swarms/swarm-1/node-1"
# expect: "swarms/swarm-1/node-2"
host haicc swarms/swarm-1/node-1 container/status
# expect: "running"
# step: taken down from the inside out: each replica removed before its node, each node before the host
host haicc swarms/swarm-1/node-1 container/remove
# expect: "removed"
host haicc swarms/swarm-1/node-2 container/remove
# expect: "removed"
host boot/teardown swarms/swarm-1/node-1
# expect: "tornDown":"swarms/swarm-1/node-1"
host boot/teardown swarms/swarm-1/node-2
# expect: "tornDown":"swarms/swarm-1/node-2"
. boot/teardown host
# expect: "tornDown":"host"
