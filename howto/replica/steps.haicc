# needs: docker
# scene: a node in the host, both in service by their commissions
. boot/deploy host haiccing/base-component-haicc
host crud/create swarms/swarm-1 '{"kind":"swarm"}'
host boot/deploy swarms/swarm-1/node-1 haiccing/base-component-haicc
# step: the replica made, and the container that will run it
host haicc swarms/swarm-1/node-1 container/create
# expect: "created"
# step: the container started: the replica's runtime runs in it, its commission bringing it into service
host haicc swarms/swarm-1/node-1 container/start
# expect: "running"
# step: the replica answers, reached through its node
host haicc swarms/swarm-1/node-1 haicc container crud/read .
# expect: "uri":["main","."]
# step: the check: the node says its container runs
host haicc swarms/swarm-1/node-1 container/status
# expect: "running"
# step: removed, before the node is torn down
host haicc swarms/swarm-1/node-1 container/remove
# expect: "removed"
